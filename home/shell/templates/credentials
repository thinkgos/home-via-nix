export AI_MIMO_API_KEY=""
export AI_DEEPSEEK_API_KEY=""
export AI_OPENROUTER_API_KEY=""
export AI_NVIDIA_API_KEY=""

export AI_CLAUDE_PROVIDER=="claude"
#export AI_CLAUDE_PROVIDER="deepseek"
case "$AI_CLAUDE_PROVIDER" in
claude)
    unset ANTHROPIC_AUTH_TOKEN \
        ANTHROPIC_BASE_URL \
        ANTHROPIC_MODEL \
        ANTHROPIC_DEFAULT_HAIKU_MODEL \
        ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME \
        ANTHROPIC_DEFAULT_OPUS_MODEL \
        ANTHROPIC_DEFAULT_OPUS_MODEL_NAME \
        ANTHROPIC_DEFAULT_SONNET_MODEL \
        ANTHROPIC_DEFAULT_SONNET_MODEL_NAME
    ;;
mimo)
    AI_CLAUDE_API_KEY="$AI_MIMO_API_KEY"
    AI_CLAUDE_BASE_URL="https://token-plan-cn.xiaomimimo.com/anthropic"
    AI_CLAUDE_MODEL="mimo-v2.6-pro"
    AI_CLAUDE_HAIKU_MODEL="$AI_CLAUDE_MODEL"
    AI_CLAUDE_OPUS_MODEL="$AI_CLAUDE_MODEL"
    AI_CLAUDE_SONNET_MODEL="$AI_CLAUDE_MODEL"
    ;;
deepseek)
    AI_CLAUDE_API_KEY="$AI_DEEPSEEK_API_KEY"
    AI_CLAUDE_BASE_URL="https://api.deepseek.com/anthropic"
    AI_CLAUDE_MODEL="deepseek-v4-flash"
    AI_CLAUDE_HAIKU_MODEL="$AI_CLAUDE_MODEL"
    AI_CLAUDE_OPUS_MODEL="$AI_CLAUDE_MODEL"
    AI_CLAUDE_SONNET_MODEL="$AI_CLAUDE_MODEL"
    ;;
openrouter)
    AI_CLAUDE_API_KEY="$AI_OPENROUTER_API_KEY"
    AI_CLAUDE_BASE_URL="https://openrouter.ai/api"
    AI_CLAUDE_MODEL="anthropic/claude-opus-5"
    AI_CLAUDE_HAIKU_MODEL="$AI_CLAUDE_MODEL"
    AI_CLAUDE_OPUS_MODEL="$AI_CLAUDE_MODEL"
    AI_CLAUDE_SONNET_MODEL="$AI_CLAUDE_MODEL"
    ;;
nvidia)
    AI_CLAUDE_API_KEY="$AI_NVIDIA_API_KEY"
    AI_CLAUDE_BASE_URL="https://integrate.api.nvidia.com"
    AI_CLAUDE_MODEL="deepseek-ai/deepseek-v4-pro-0813"
    AI_CLAUDE_HAIKU_MODEL="$AI_CLAUDE_MODEL"
    AI_CLAUDE_OPUS_MODEL="$AI_CLAUDE_MODEL"
    AI_CLAUDE_SONNET_MODEL="$AI_CLAUDE_MODEL"
    ;;
esac

if [ "$AI_CLAUDE_PROVIDER" != "claude" ]; then
    export ANTHROPIC_AUTH_TOKEN="$AI_CLAUDE_API_KEY"
    export ANTHROPIC_BASE_URL="$AI_CLAUDE_BASE_URL"
    export ANTHROPIC_MODEL="$AI_CLAUDE_MODEL"
    export ANTHROPIC_DEFAULT_HAIKU_MODEL="$AI_CLAUDE_HAIKU_MODEL"
    export ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME="$AI_CLAUDE_HAIKU_MODEL"
    export ANTHROPIC_DEFAULT_OPUS_MODEL="$AI_CLAUDE_OPUS_MODEL"
    export ANTHROPIC_DEFAULT_OPUS_MODEL_NAME="$AI_CLAUDE_OPUS_MODEL"
    export ANTHROPIC_DEFAULT_SONNET_MODEL="$AI_CLAUDE_SONNET_MODEL"
    export ANTHROPIC_DEFAULT_SONNET_MODEL_NAME="$AI_CLAUDE_SONNET_MODEL"
fi
