Config(
  // Set to false to disable built-in power actions (default: true).
  enable_power_actions: true,
  // Add your own custom actions here.
  custom_actions: [
    (
      // Required.
      title: "Open Browser",
      // Required. The command is passed through shell.
      command: "xdg-open https://www.google.com",
      // Optional.
      description: "Launch the default web browser",
      // Optional.
      icon: "web-browser",
      // Optional (default: false).
      confirm: false,
    ),
    (
      title: "🪟 Window Switch",
      command: "vicinae vicinae://launch/wm/switch-windows",
      description: "窗口切换",
      icon: "web-browser",
      confirm: false,
    ),
    (
      title: "😀 Search Emoji",
      command: "vicinae vicinae://launch/core/search-emojis",
      description: "搜索Emoji",
      icon: "web-browser",
      confirm: false,
    ),
    (
      title: "🖼️ Wallpaper Picker",
      command: "hvn-picker-wallpaper -m normal",
      description: "设置壁纸",
      icon: "web-browser",
      confirm: false,
    ),
    (
      title: "🖼️ Wallpaper Picker Side",
      command: "hvn-picker-wallpaper -m side",
      description: "设置壁纸（侧边栏）",
      icon: "web-browser",
      confirm: false,
    ),
    (
      title: "🖼️ Wallpaper Picker For Backdrop",
      command: "hvn-picker-wallpaper --layer backdrop",
      description: "设置背景幕布",
      icon: "web-browser",
      confirm: false,
    ),
    (
      title: "🧪 Color Picker",
      command: "pkill -SIGUSR1 ie-r",
      description: "颜色拾取",
      icon: "web-browser",
      confirm: false,
    ),
    (
      title: " Color History",
      command: "pkill -SIGUSR2 ie-r",
      description: "颜色历史",
      icon: "web-browser",
      confirm: false,
    ),
    (
      title: "🎨 Color Chooser",
      command: "pkill kcolorchooser || kcolorchooser",
      description: "颜色选择器",
      icon: "web-browser",
      confirm: false,
    ),
    (
      title: "🗒️ Clipboard History Overview",
      command: "vicinae vicinae://launch/clipboard/history",
      description: "剪贴板历史记录概览",
      icon: "web-browser",
      confirm: false,
    ),
    (
      title: "🧹 Clipboard History Wipe",
      command: "vicinae vicinae://launch/clipboard/clear-history",
      description: "清除剪贴板历史记录",
      icon: "web-browser",
      confirm: false,
    ),
    (
      title: "📹 Screen Recorder",
      command: "flatpak run io.github.seadve.Kooha",
      description: "交互录屏",
      icon: "web-browser",
      confirm: false,
    ),
    (
      title: "📄 OCR",
      command: "hvn-screen -m ocr",
      description: "OCR识别",
      icon: "web-browser",
      confirm: false,
    ),
    (
      title: "📏 Screen Pixel Measure",
      command: "hvn-screen -m pixel-measure",
      description: "像素测量",
      icon: "web-browser",
      confirm: false,
    ),
    (
      title: "🪟 Window Screenshot",
      command: "hvn-screen -m window",
      description: "窗口截图",
      icon: "web-browser",
      confirm: false,
    ),
    (
      title: "🖥️ Fullscreen Screenshot",
      command: "hvn-screen -m fullscreen",
      description: "全屏截图",
      icon: "web-browser",
      confirm: false,
    ),
    (
      title: "✂️ Region Screenshot",
      command: "hvn-screen -m region",
      description: "选框截图",
      icon: "web-browser",
      confirm: false,
    ),
    (
      title: "🪟 Window Screenshot📝",
      command: "hvn-screen -m window-annotate",
      description: "窗口截图📝",
      icon: "web-browser",
      confirm: false,
    ),
    (
      title: "🖥️ Fullscreen Screenshot📝",
      command: "echo 'TODO: screenshot fullscreen + annotate'",
      description: "全屏截图📝",
      icon: "web-browser",
      confirm: false,
    ),
    (
      title: "✂️ Region Screenshot📝",
      command: "hvn-screen -m region-annotate",
      description: "选框截图📝",
      icon: "web-browser",
      confirm: false,
    ),
    (
      title: "🎞️ Scroll Screenshot",
      command: "hvn-screen -m scroll",
      description: "滚动截图",
      icon: "web-browser",
      confirm: false,
    ),
    (
      title: "🎞️ Scroll Screenshot Preview🔍",
      command: "hvn-screen -m scroll-preview",
      description: "滚动截图并预览",
      icon: "web-browser",
      confirm: false,
    ),
  ],
)
